{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=1024 tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "postinstall": "prisma generate",
    "test": "jest --runInBand --detectOpenHandles --config ./jest.config.ts",
    "pretest:int": "docker run --name db_testing -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=testing -p 5433:5432 -d postgres && npx wait-on tcp:5433",
    "db:migrate:test": "npx dotenv-cli -e .env.test -- prisma migrate deploy",
    "test:int": "npx dotenv-cli -e .env.test -- jest --runInBand --config ./jest.integration.config.ts",
    "posttest:int": "docker stop db_testing && docker rm db_testing",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:setup": "npm run db:migrate:deploy && npm run db:seed",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [],
  "author": "Tatiane Weitzel",
  "license": "ISC",
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "prisma": "6.15.0",
    "stripe": "^18.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  }
}