{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/tests/**"
  ]
}
