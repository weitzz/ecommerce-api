{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/tests/**"
  ]
}